.page {
  padding: 28rpx;
  padding-bottom: 60rpx;
}

.hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

.mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
  background: #1f2523;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}

.hero-copy {
  flex: 1;
}

.eyebrow {
  color: #66716c;
  font-size: 22rpx;
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}

.title {
  color: #1f2523;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.05;
}

.subtitle,
.muted,
.time {
  color: #66716c;
  font-size: 26rpx;
  line-height: 1.45;
}

.tabs {
  white-space: nowrap;
  margin-bottom: 22rpx;
}

.tab {
  display: inline-flex;
  min-width: 112rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #66716c;
  font-weight: 800;
  font-size: 26rpx;
}

.tab-active {
  background: #1f2523;
  color: #ffffff;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #dce3df;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  color: #1f2523;
  font-size: 38rpx;
  font-weight: 900;
  margin: 8rpx 0 22rpx;
}

.status,
.metric-value,
.log-title {
  color: #1f2523;
  font-size: 30rpx;
  font-weight: 900;
}

.metrics,
.grid,
.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.metric,
.grid .input,
.grid picker {
  flex: 1;
}

.metric,
.result,
.log,
.pre {
  border: 1rpx solid #dce3df;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-top: 18rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 76rpx;
  border: 1rpx solid #dce3df;
  border-radius: 14rpx;
  background: #f8faf8;
  color: #1f2523;
  padding: 18rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.textarea {
  min-height: 160rpx;
}

.primary,
.ghost,
.chip {
  min-height: 78rpx;
  line-height: 78rpx;
  border-radius: 14rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.primary {
  background: #1f2523;
  color: #ffffff;
}

.ghost,
.chip {
  background: #f8faf8;
  color: #1f2523;
  border: 1rpx solid #1f2523;
}

.tall {
  min-height: 150rpx;
  line-height: 150rpx;
  border-style: dashed;
}

.chip {
  flex: 1;
  min-width: 0;
}

.chip-active {
  background: #1f2523;
  color: #ffffff;
}

.warning {
  background: #fbf3df;
  color: #7c5620;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.pre {
  white-space: pre-wrap;
  word-break: break-word;
  color: #4f5a56;
  background: #f8faf8;
  font-size: 24rpx;
}
